<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStack" styleClass="shell" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.studentnest.controller.MainController">
    <BorderPane fx:id="shell">
        <top>
            <HBox fx:id="topBar" styleClass="topbar" alignment="CENTER_LEFT" spacing="14">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <StackPane styleClass="brand-mark">
                        <Label text="SN" styleClass="brand-mark-label"/>
                    </StackPane>
                    <VBox spacing="0">
                        <Label text="StudentNest" styleClass="brand-title"/>
                        <Label text="DIU accommodation marketplace" styleClass="brand-sub"/>
                    </VBox>
                </HBox>
                <Label fx:id="versionBadge" text="v3.1 Modern" styleClass="badge, badge-blue"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Region fx:id="dbDot" styleClass="status-dot, status-dot-on"/>
                    <Label fx:id="dbStatusLabel" text="SQLite connected" styleClass="muted"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="topbar-actions">
                    <Button fx:id="favoritesChip" text="♥ 0 Saved" styleClass="topbar-btn, topbar-fav-btn" onAction="#openFavorites"/>
                    <Button fx:id="themeButton" text="🌙 Dark" styleClass="topbar-btn, topbar-theme-btn" onAction="#toggleTheme"/>
                    <Region styleClass="topbar-divider"/>
                    <HBox styleClass="user-profile-pill" alignment="CENTER_LEFT" spacing="8">
                        <StackPane styleClass="avatar">
                            <Label fx:id="avatarLabel" text="G" styleClass="avatar-label"/>
                        </StackPane>
                        <VBox spacing="0" alignment="CENTER_LEFT">
                            <Label fx:id="userNameLabel" text="Guest" styleClass="user-pill-name"/>
                            <Label fx:id="roleBadge" text="Guest" styleClass="user-pill-role"/>
                        </VBox>
                    </HBox>
                    <Button fx:id="authButton" text="Sign in" styleClass="topbar-auth-btn, topbar-auth-signin" onAction="#onAuthClicked"/>
                </HBox>
            </HBox>
        </top>
        <left>
            <VBox fx:id="sidebar" styleClass="sidebar">
                <Label text="Navigate" styleClass="sidebar-section-title"/>
                <Button fx:id="navHome" text="Home Overview" styleClass="nav-button, active" onAction="#showHome"/>
                <Button fx:id="navBrowse" text="Browse Properties" styleClass="nav-button" onAction="#showBrowse"/>
                <Button fx:id="navFavorites" text="Saved Favorites" styleClass="nav-button" onAction="#openFavorites"/>
                <Button fx:id="navList" text="List Property" styleClass="nav-button" onAction="#showListProperty"/>
                <Button fx:id="navMine" text="My Listings" styleClass="nav-button" onAction="#showMyListings"/>
                <Button fx:id="navAdmin" text="Admin Panel" styleClass="nav-button" onAction="#showAdmin"/>
                <Button fx:id="navFeedback" text="Feedback &amp; Reviews" styleClass="nav-button" onAction="#showFeedback"/>
                <Button fx:id="navAbout" text="About StudentNest" styleClass="nav-button" onAction="#showAbout"/>
            </VBox>
        </left>
        <center>
            <ScrollPane fx:id="contentScroll" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">
                <StackPane fx:id="contentPane" styleClass="content"/>
            </ScrollPane>
        </center>
    </BorderPane>
</StackPane>
